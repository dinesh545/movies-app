<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#2A4365" />
            <stroke android:width="2.5dp" android:color="#F59E0B" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#38BDF8" />
            <stroke android:width="1dp" android:color="#38BDF8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#1E293B" />
            <stroke android:width="1dp" android:color="#334155" />
        </shape>
    </item>
</selector>